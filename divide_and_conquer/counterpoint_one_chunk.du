#builtin INT_PLUS plus
#builtin INT_MINUS minus
#builtin NAT_SUCC suc

# Remarks:
# - the "stepwise contrary cadence" rule requires the cf to end by
#   moving a single step, or else no solutions will be found
# - major/minor/augmented checking is not implemented
# - cantus firmus is always assumed to be below counterpoint


# ##### Consonance #####
# The interval between the given note and the note in your counter-melody should be consonant
# (major/minor 3rd or 6th, perfect unison, 5th, or octave, or a compound form).

interval unison is 0.
interval third is 2.
interval fifth is 4.
interval sixth is 5.
interval octave is 7.

cp T is? I :-
  cf T is _,
  interval I is _.

# Calculate counterpoint scale degree.
cpNote T is (plus N (interval I)) :-
  cp T is I,
  cf T is N.

# Distance between counterpoint notes T and T+1 (in absolute value).
#lazy cpMovement
cpMovement T is (minus N2 N1) :-
  cpNote T is N1,
  cpNote (suc T) is N2,
  N2 >= N1.
cpMovement T is (minus N1 N2) :-
  cpNote T is N1,
  cpNote (suc T) is N2,
  N1 > N2.

# A leap is when the cp moves by a 3rd or more.
#lazy leap
leap T :-
  cpMovement T > 1.

#lazy directMotion
directMotion T :-
  cf T is _,
  cf (suc T) > cf T,
  cpNote (suc T) > cpNote T.

directMotion T :-
  cf T is _,
  cf (suc T) < cf T,
  cpNote (suc T) < cpNote T.


# ##### No unisons in the the middle #####
# Unison is not allowed except the first and the last interval.

#forbid unisoninMiddle _.

unisoninMiddle T :-
  cf T is _,
  T > 0,
  T < length,
  cp T is unison.


# ##### Valid start/ending intervals #####
# The interval between the first (resp., final) given notes and the corresponding note in your
# counter-melody must be a unison or octave.

cp 0 is {unison, octave}.
cp length is {unison, octave}.


# ##### Stepwise contrary cadence #####
# The cadence interval must be approached by stepwise contrary motion, i.e., the given melody and
# the counter-melody must both move a single step in opposite directions.

#demand cadenceStepwiseContrary.

cadenceStepwiseContrary :-
  suc T is length,
  suc (cf T) == cf length,
  cpNote T == suc (cpNote length).

cadenceStepwiseContrary :-
  suc T is length,
  cf T == suc (cf length),
  suc (cpNote T) == cpNote length.


# ##### Direct octaves or fifths #####
# If both voices are moving in the same direction (and the upper voice by jump),
# they should not move to a vertical octave or fifth.

#forbid directOctave _.
#forbid directFifth _.

directOctave T :-
  cf T is _,
  cp (suc T) is octave,
  directMotion T,
  leap T.

directFifth T :-
  cf T is _,
  cp (suc T) is fifth,
  directMotion T,
  leap T.


# ##### Parallel octaves or fifths #####
# If the previous harmonic interval was an octave or fifth,
# your next note should not create the same harmonic interval again.

#forbid parallelOctave _.
#forbid parallelFifth _.

parallelOctave T :-
  cp T is octave,
  cp (suc T) is octave.

parallelFifth T :-
  cp T is fifth,
  cp (suc T) is fifth.


# ##### Counterpoint movement #####
# Your counter-melody should move in steps, or in leaps of a 3rd, 4th, 5th, or 6th.

#forbid invalidCPMovement _.

invalidCPMovement T :-
  cf T is _,
  cpMovement T > 5.

invalidCPMovement T :-
  cf T is _,
  cpMovement T is 0.


# ##### Successive large leaps #####
# Your counter-melody should not contain multiple successive large leaps (5th or
# larger) in the same direction.

#forbid twoLargeLeapsUp _.
#forbid twoLargeLeapsDown _.

twoLargeLeapsUp T :-
  cf T is _,
  cpNote (suc T) > plus 3 (cpNote T),
  cpNote (plus T 2) > plus 3 (cpNote (suc T)).

twoLargeLeapsDown T :-
  cf T is _,
  plus 3 (cpNote (suc T)) < cpNote T,
  plus 3 (cpNote (plus T 2)) < cpNote (suc T).


# ##### Four leaps #####
# Your counter melody should not contain more than 3 leaps in a row.

#forbid fourLeaps _.

fourLeaps T :-
  cf T is _,
  leap T,
  leap (plus T 1),
  leap (plus T 2),
  leap (plus T 3).


# ##### "I/O" #####

# Generate "output"

at T 0 is N :- cf T is N.
at T 1 is N :- cpNote T is N.

# "User" "inputs" cantus firmus voice here
# cf [note number] is [note degree]

