#builtin INT_PLUS plus.
#builtin NAT_SUCC suc.

interval union.
interval third.
interval fifth.
interval sixth.
interval octave.

difference union is 0.
difference third is 2.
difference fifth is 4.
difference sixth is 5.
difference octave is 7.


bar 0.

bar (suc N) :-
  at N 0 is A,
   at N 1 is B.

cp N is? I :- interval I, bar N.

cfSame N :-
  cf N M,
  cf (suc N) M.

cfUp N :-
  cf N A,
  cf (suc N) B,
  B > A.

cfDown N :-
  cf N A,
  cf (suc N) B,
  A > B.

cpSame N :-
  cp N is  I1,
  cp (suc N) is I2,
  cf N R1,
  cf (suc N) R2,
  plus R1 (difference I1) == plus R2 (difference I2).


cpUp N :-
  cp N is I1,
  cp (suc N) is I2,
  cf N R1,
  cf (suc N) R2,
  plus R1 (difference I1) < plus R2 (difference I2).


cpDown N :-
  cp N is I1,
  cp (suc N) is I2,
  cf N R1,
  cf (suc N) R2,
  plus R1 (difference I1) > plus R2 (difference I2).


contrary (suc N) :-  cpDown N, cfUp N.
contrary (suc N) :-  cpUp N, cfDown N.


#  from a 6th stepwise outward to octave
cadence (suc N) :-
  cfDown N, cpUp N, cp N is sixth, cp (suc N) is octave.
# from a 3rd stepwise inward to unison
cadence (suc N) :-
  cfUp N, cpDown N, cp N is third, cp (suc N) is union.

# r1 and r2 are natural numbers, i1 and i2 are consonant ivls
# nd58 R1 I1 R2 I2 :- n58 I2.
n58 N :-  cp N is union.
n58 N :-  cp N is third.
n58 N :-  cp N is sixth.
nd58 N :- n58 M, suc N is M.
nd58 N :- cfUp N, cpDown N.
nd58 N :- cfDown N, cpUp N.
nd58 N :- cfSame N.
nd58 N :- cpSame N.

sound_at N :- nd58 N.

sound 0 :- sound_at 0.
sound (suc N) :-
  sound N,
  sound_at (suc N).


music N :- sound N, bar (suc N).

at T 0 is N :- cf T N.
at T 1 is N :-
  cp T is I,
  cf T M,
  plus M (difference I) == N.


end is (suc N) :- length is N.

validBegin :- cp 0 is union.
validBegin :- cp 0 is octave.

validLast :- cp length is union.
validLast :- cp length is octave.


# Specify the length of the piece
#demand music length.
#forbid music end.
#demand validBegin.
#demand validLast.
# demand cadence length.

directFifth N :- cfUp N, cpUp N, cp (suc N) is fifth.
directFifth N :- cfDown N, cpDown N, cp (suc N) is fifth.
# #demand directFifth N.

# "User" "inputs" cantus firmus voice here
# index then note degree
# cf 0 0.
# cf 1 2.
# cf 2 3.
# cf 3 1.
# cf 4 0.

