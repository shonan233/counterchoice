#builtin INT_PLUS plus
#builtin INT_MINUS minus
#builtin NAT_SUCC suc

interval union is 0.
interval third is 2.
interval fifth is 4.
interval sixth is 5.
interval octave is 7.

# scale degrees
note 0.
note 1.
note 2.
note 3.
note 4.
note 5.
note 6.
note 7.

# make choices of counterpoint notes
judgeCP N I is? good :- 
  cf N is _, interval I is _.

cp T is? I :- interval I is _, judgeCP T I is good.

# the rest is defining what "judgeCP" means.

# calculate counterpoint scale degree
cpNote T is (plus N (interval I)) :- cp T is I, cf T is N.

# D for "degree"
#lazy movement
movement D D is same :- note D.
movement D D' is up :- note D, note D', D' > D.
movement D D' is down :- note D, note D', D' < D.

#lazy chordMovement
chordMovement N1 I1 N2 I2 is (pair M1 M2)
  :-  movement N1 N2 is M1,
      movement (plus N1 (interval I1))
               (plus N2 (interval I2)) is M2.

parallel (pair up up).
parallel (pair down down).

# prohibit direct fifths and direct octaves on parallel movement

judgeCP (suc T) fifth is bad :-
  cf T is N, cp T is I,
  cf T is N',
  chordMovement N I N' fifth is M,
  parallel M.
  
judgeCP (suc T) octave is bad :-
  cf T is N, cp T is I,
  cf T is N',
  chordMovement N I N' octave is M,
  parallel M.
  


# cadence for two cf note sequence N1 N2 
# is one of two interval sequences:

# ...from a 6th stepwise outward to octave
cadence N1 N2 is (seq sixth octave) :-
  chordMovement N1 sixth N2 octave is (pair down up).
  
# ...from a 3rd stepwise inward to unison
cadence N1 N2 is (seq third unison) :-
  chordMovement N1 third N2 unison is (pair up down).

#lazy cadence

cadenceAt T is (cadence N1 N2) :-
  cf T is N1, cf (suc T) is N2.

#lazy cadenceAt

# must start and end on union/octave, and must end on cadence

cp 0 is {union, octave}.
cp length is {union, octave}.

judgeCP T I' is bad :- 
  length is L,
  suc T is L,
  cp length is IFinal,
  cadenceAt T is (seq I IFinal),
  interval I' is _,
  I' != I.
 
# Generate "output"

at T 0 is N :- cf T is N.
at T 1 is N :- cpNote T is N.

# "User" "inputs" cantus firmus voice here
# cf [note number] is [note degree]
# cf 0 is 0.
# cf 1 is 2.
# cf 2 is 3.
# cf 3 is 1.
# cf 4 is 0.
# length is 4.

#
# Generated cf facts and "length is _" fact goes below

