#builtin INT_PLUS plus
#builtin INT_MINUS minus
#builtin NAT_SUCC suc
#builtin BOOLEAN_TRUE true
#builtin BOOLEAN_FALSE false


# Remarks:
# - cantus firmus is always assumed to be below counterpoint


# ##### Consonance #####
# (major/minor 3rd or 6th, perfect unison, 5th, or octave, or a compound form).

interval unison is 0.
interval second is 1.
interval third is 2.
interval fourth is 3.
interval fifth is 4.
interval sixth is 5.
interval seventh is 6.
interval octave is 7.

consonant unison.
consonant third.
consonant fifth.
consonant sixth.
consonant octave.

dissonant second.
dissonant fourth.
dissonant seventh.

perfect unison.
perfect fifth.
perfect octave.

imperfect third.
imperfect sixth.

# downbeat (strong), only consonants allowed just like first species
cp T 0 is? I :-
  cf T is _,
  T > 0,
  T < length,
  consonant I.
# upbeat (weak), dissonances are allowed if they are passing (approached and left by a step), otherwise consonant
cp T 1 is? I :-
  cf T is _,
  T < length,
  interval I is _.

badDissonance T :-
  cp T 1 is I,
  dissonant I,
  leap T 0 T 1.

badDissonance T :-
  cp T 1 is I,
  dissonant I,
  cpMovement T 0 T 1 is 0.

badDissonance T :-
  cp T 1 is I,
  dissonant I,
  leap T 1 (suc T) 0.

badDissonance T :-
  cp T 1 is I,
  dissonant I,
  cpMovement T 1 (suc T) 0 is 0.


# Calculate counterpoint scale degree.
# T is timestep, B is beat.
cpNote T B is (plus N (interval I)) :-
  cp T B is I,
  cf T is N.

# Distance between counterpoint notes T and T+1 (in absolute value).
#lazy cpMovement
cpMovement T 0 T 1 is (minus N2 N1) :-
  cpNote T 0 is N1,
  cpNote T 1 is N2,
  N2 >= N1.
cpMovement T 0 T 1 is (minus N1 N2) :-
  cpNote T 0 is N1,
  cpNote T 1 is N2,
  N1 > N2.

cpMovement T 1 (suc T) 0 is (minus N2 N1) :-
  cpNote T 1 is N1,
  cpNote (suc T) 0 is N2,
  N2 >= N1.
cpMovement T 1 (suc T) 0 is (minus N1 N2) :-
  cpNote T 1 is N1,
  cpNote (suc T) 0 is N2,
  N1 > N2.

# A leap is when the cp moves by a 3rd or more.
#lazy leap
leap T1 B1 T2 B2 :-
  cpMovement T1 B1 T2 B2 > 1.

# A step is when the cp moves by 1.
#lazy step
step T1 B1 T2 B2 :-
  cpMovement T1 B1 T2 B2 == 1.

#lazy directMotion
directMotion T 1 (suc T) 0 :-
  cf T is _,
  cf (suc T) > cf T,
  cpNote (suc T) 0 > cpNote T 1.

directMotion T 1 (suc T) 0 :-
  cf T is _,
  cf (suc T) < cf T,
  cpNote (suc T) 0 < cpNote T 1.


# ##### No unisons except first #####
# Unison is not allowed except the first interval.

unisonExceptFirst T :-
  cf T is _,
  T != 0,
  cp T _ is unison.


# ##### Valid start/ending intervals #####

startAtUpbeat is {true, false}.
cp 0 1 is {unison, octave} :-
  startAtUpbeat is true.
cp 0 0 is {unison, octave} :-
  startAtUpbeat is false.
cp length 0 is octave.


# ##### fifth sixth octave ending #####
# approach the final octave with intervals of a fifth and sixth

endingFifthSixth :-
  suc T is length,
  cp T 0 is fifth,
  cp T 1 is sixth. 

raiseLeading is? false.
raiseLeading is true :-
  mode is minor.

  

# ##### Direct octaves or fifths #####
# If both voices are moving in the same direction (and the upper voice by jump),
# they should not move to a vertical octave or fifth,
# Checking only when crossing bars

directOctave T :-
  cf T is _,
  cp (suc T) 0 is octave,
  directMotion T 1 (suc T) 0,
  leap T 1 (suc T) 0.

directFifth T :-
  cf T is _,
  cp (suc T) 0 is fifth,
  directMotion T 1 (suc T) 0,
  leap T 1 (suc T) 0.


# ##### Parallel octaves or fifths #####
# If the previous harmonic interval was an octave or fifth,
# the next downbeat should not create the same harmonic interval again.
# checking both when crossing bars, and for consecutive downbeats (unless there is a leap of 4th?)

parallelOctave T :-
  cp T 1 is octave,
  cp (suc T) 0 is octave.

parallelFifth T :-
  cp T 1 is fifth,
  cp (suc T) 0 is fifth.

parallelOctaveDB T :-
  cp T 0 is octave,
  cp (suc T) 0 is octave.

parallelFifthDB T :-
  cp T 0 is fifth,
  cp (suc T) 0 is fifth.


# ##### Counterpoint movement #####
# No repeated notes in the countermelody
# leaps are allowed up to octave?

invalidCPMovement T1 0 T1 1 :-
  cpNote T1 0 is _,
  cpMovement T1 0 T1 1 > 7.
invalidCPMovement T1 1 T2 0 :-
  cpNote T1 1 is _,
  (suc T1) is T2,
  cpMovement T1 1 T2 0 > 7.

invalidCPMovement T1 0 T1 1 :-
  cpNote T1 0 is _,
  cpMovement T1 0 T1 1 is 0.
invalidCPMovement T1 1 T2 0 :-
  cpNote T1 1 is _,
  (suc T1) is T2,
  cpMovement T1 1 T2 0 is 0.






# ##### "I/O" #####

# Generate "output"

# "User" "inputs" cantus firmus voice here
# cf [note number] is [note degree]
#forbid badDissonance _.
#forbid unisonExceptFirst _.
#forbid directOctave _.
#forbid directFifth _.
#forbid parallelOctave _.
#forbid parallelFifth _.
#forbid parallelOctaveDB _.
#forbid parallelFifthDB _.
#forbid invalidCPMovement _ _ _ _.
#demand endingFifthSixth.
# cf 0 is 1.
# cf 1 is 0.
# cf 2 is 1.
# cf 3 is 2.
# cf 4 is 3.
# cf 5 is 4.
# cf 6 is 5.
# cf 7 is 4.

# length is 7.
# key is 7. # will be used by the frontend to transpose the results found here
# mode is major. # can be major or minor, also will be used by the frontend to find the correct notes

