#builtin INT_PLUS plus
#builtin INT_MINUS minus
#builtin NAT_SUCC suc

interval unison is 0.
interval third is 2.
interval fifth is 4.
interval sixth is 5.
interval octave is 7.

intervalName unison.
intervalName third.
intervalName fifth.
intervalName sixth.
intervalName octave.



# scale degrees
note 0.
note 1.
note 2.
note 3.
note 4.
note 5.
note 6.
note 7.
note 8.
note 9.
note 10.
note 11.
note 12.
note 13.
note 14.

time T :-
cf T is _.


cp T is? I :-
  time T,
  intervalName I.

# the rest is defining what "judgeCP" means.

# calculate counterpoint scale degree
cpNote T is (plus N (interval I)) :- cp T is I, cf T is N.

# D for "degree"
#lazy movement
movement D D is same :- note D.
movement D D' is up :- note D, note D', D' > D.
movement D D' is down :- note D, note D', D' < D.

#lazy chordMovement
chordMovement N1 I1 N2 I2 is (pair M1 M2)
  :-  movement N1 N2 is M1,
      movement (plus N1 (interval I1))
               (plus N2 (interval I2)) is M2.

#lazy parallel
parallel (pair up up).
parallel (pair down down).




# Ensures a valid starting interval.
cp 0 is {unison, octave}.




# This version assumes the user will enter a valid cf ending that is either ascending or descending, otherwise the conditions will not be satisfied and it will allow all endings
cadenceNotThirdUnison (minus length 1) I :-
  (minus length 1) is T,
  cp T is I,
  (cf (suc T)) > (cf T),
  I != third.

cp length is unison :-
  cp (minus length 1) is third.

cadenceNotSixthOctave (minus length 1) I :-
  (minus length 1) is T,
  cp T is I,
  (cf (suc T)) < (cf T),
  I != sixth.

cp length is octave :-
  cp (minus length 1) is sixth.





# counts the distance between two consecutive notes in the counterpoint melody, in absolute value
#lazy intervalCP
intervalCP (suc T) is (minus N2 N1) :-
  cpNote T is N1,
  cpNote (suc T) is N2,
  N2 > N1.
intervalCP (suc T) is (minus N1 N2) :-
  cpNote T is N1,
  cpNote (suc T) is N2,
  N1 > N2.
intervalCP (suc T) is 0 :-
  cpNote T is N1,
  cpNote (suc T) is N2,
  N1 == N2.




# a step is when the cp moves by only 1 in the next note
step T :-
  intervalCP T is 1. # shortened by setting it directly to 1

# a leap is when the cp moves by a 3rd or more
leap T :-
  intervalCP T is D,
  D > 1.

# a largeLeap is when the cp moves by a 5th or 6th
largeLeap T :-
  intervalCP T is D,
  D > 3.
# Both in leap and largeLeap, there is no upper bound checking since the checking is done in the invalidCPmov part
#lazy step
#lazy leap
#lazy largeLeap


# I modified the rule prohibiting  direct fifths and direct octaves on parallel movement to also check for jumps (leaps) in the counterpoint melody, stated as "Direct octaves or fifths: if both voices are moving in the same direction (and the upper voice by jump), they should not move to a vertical octave or fifth."
directOctave (suc T) octave :-
  cf T is N, cp T is I,
  cf (suc T) is N',
  chordMovement N I N' octave is M,
  parallel M,
  leap (suc T),
  cp (suc T) is octave.
directFifth (suc T) fifth :-
  cf T is N, cp T is I,
  cf (suc T) is N',
  chordMovement N I N' fifth is M,
  parallel M,
  leap (suc T),
  cp (suc T) is fifth.

# The following two implement the rule: "Parallel fifths: if the previous harmonic interval was a fifth, your next note should not create the same harmonic interval again."
# and the rule: "Parallel octaves: if the previous harmonic interval was an octave, your next note should not create the same harmonic interval again."
parallelOctave (suc T) octave :-
  cp T is octave,
  cp (suc T) is octave.
parallelFifth (suc T) fifth :-
  cp T is fifth,
  cp (suc T) is fifth.


# invalidCPmov is a counterpoint melody movement that is not allowed in the rule: "Your counter-melody should move in steps, or in leaps of a 3rd, 4th, 5th, or 6th."
#lazy invalidCPmov
invalidCPmov T :-
  time T,
  (suc T) is T1,
  intervalCP T1 is D,
  D > 5.
invalidCPmov T :-
  time T,
  (suc T) is T1,
  intervalCP T1 is 0.

invalidCPMovement (suc T) I :-
  time T,
  cp (suc T) is I,
  invalidCPmov T.


# The following implements the following rule using the largeLeap defined before: "Your counter-melody should not contain multiple successive large leaps (5th or 6th) in the same direction."
twoLargeLeapsUp T2 I :-
  time T,
  (suc T) is T1,
  (suc T1) is T2,
  cp T2 is I,
  largeLeap (T1),
  largeLeap (T2),
  movement (cpNote T) (cpNote T1) is up,
  movement (cpNote T1) (cpNote T2) is up.

twoLargeLeapsDown T2 I :-
  time T,
  (suc T) is T1,
  (suc T1) is T2,
  cp T2 is I,
  largeLeap (T1),
  largeLeap (T2),
  movement (cpNote T) (cpNote T1) is down,
  movement (cpNote T1) (cpNote T2) is down.

  

# implements "Your counter melody should not contain more than 3 leaps in a row."
fourLeaps T4 I :-
  time T,
  (suc T) is T1,
  (suc T1) is T2,
  (suc T2) is T3,
  (suc T3) is T4,
  cp T4 is I,
  leap (T1),
  leap (T2),
  leap (T3),
  leap (T4).






# Generate "output"

at T 0 is N :- cf T is N.
at T 1 is N :- cpNote T is N.



#forbid forbidden cadenceNotThirdUnison, cadenceNotThirdUnison _ _.
#forbid forbidden cadenceNotSixthOctave, cadenceNotSixthOctave _ _.
#forbid forbidden directOctave, directOctave _ _.
#forbid forbidden directFifth, directFifth _ _.
#forbid forbidden parallelOctave, parallelOctave _ _.
#forbid forbidden parallelFifth, parallelFifth _ _.
#forbid forbidden invalidCPMovement, invalidCPMovement _ _.
#forbid forbidden twoLargeLeapsUp, twoLargeLeapsUp _ _.
#forbid forbidden twoLargeLeapsDown, twoLargeLeapsDown _ _.
#forbid forbidden fourLeaps, fourLeaps _ _.


# "User" "inputs" cantus firmus voice here
# cf [note number] is [note degree]

# Remarks
# Important: The cadence rule requires the cf to end with either upwards or downwards motion, if it stays the same, then all endings are accepted.
# major/minor/augmented checking is not implemented
# cantus firmus is always assumed to be below counterpoint

